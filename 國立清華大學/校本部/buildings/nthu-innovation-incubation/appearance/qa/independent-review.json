  "source_identity_and_dates": [
    "九典聯合建築師事務所公開完工作品之三張原照；不是校方擁有影像，photo4本身為左右拼圖。",
    "三圖EXIF及ExifIFD實讀均空，XMP無CreateDate/ModifyDate/MetadataDate；2012 toolkit字串是軟體版本而非攝影日期。作品2011–2016與URL2024/11亦不是拍攝日期，不稱2026現況。",
    "photo1明辨高樓暖磚外框與低翼深灰金屬簷；photo3確認高樓內退磚帶/混材玻璃界；photo4右半補低翼簷，左半院落與鄰樓不可併入。"
  ],
  "visual_findings": [
    {
      "view": "previews/front.png",
      "finding": "親看：暖磚頂前框、雙豎框與低翼深灰簷清楚連續可辨；灰色內窄框及內退角面仍留中性，沒有用碎色塊強行補齊。原幕牆格網簡化沒有因本次塗色被說成真實全部磚牆。"
    },
    {
      "view": "previews/rear.png",
      "finding": "親看：反面、背窗與背框全部中性，沒有從正面推色；全主體在畫框內。"
    },
    {
      "view": "previews/elevation.png",
      "finding": "親看：暖磚高框與深灰低簷的對比最清楚；高框內側灰窄帶屬保守未配範圍，不是宣稱天然材料接縫或白色施工材。沒有片狀棋盤/孤立錯色污染。"
    },
    {
      "view": "previews/side.png",
      "finding": "親看：端牆、端部減量葉片與水平簷/底皆中性；未套實景彩色葉片規律或把未知面塗玻璃。"
    },
    {
      "view": "previews/top.png",
      "finding": "親看：水平屋頂及低翼頂不染，院落負空間保持；俯視看不到正向彩面屬合理角度，不是漏渲。"
    }
  ],
  "benefit_and_residual_distortion": {
    "decision": "LIMITED_COLOR_BENEFIT_ACCEPTABLE",
    "reason": "新增色彩仍形成有來源支持的連續高樓外框與低簷識別特徵，並非僅零星三角。中性缺口雖可見，README已明說磚框不完整，故不必越界擴選以補色。",
    "not_claimed": "不聲稱全部磚面已復原。實景樓層磚帶/玻璃與原模型格網不同；原兩翼深度、低層邊界、梯形玻璃及葉片減量均維持歷史近似，不是本輪幾何核准或現況精準度提升。"
  },
